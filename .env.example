# Copy to .env and fill in values. Never commit .env.

# Claude API key (optional). Without it the app still runs;
# only POST /api/ai/code-review returns 503.
ANTHROPIC_API_KEY=

# Claude model used for code review
CLAUDE_MODEL=claude-opus-5-5

# PostgreSQL (used by docker-compose)
POSTGRES_DB=aiplatform
POSTGRES_USER=aiplatform
POSTGRES_PASSWORD=change-me

# Host ports
APP_PORT=8080
POSTGRES_PORT=5432
